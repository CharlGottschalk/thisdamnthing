#!/bin/sh
set -eu
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$hook_dir/check.py" pre-commit "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$hook_dir/check.py" pre-commit "$@"
else
    echo "ThisDamnThing Git hooks require Python 3.11+." >&2
    exit 1
fi
