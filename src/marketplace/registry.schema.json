{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dryft public marketplace registry v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/listing"
      },
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "stacks"
  ],
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "active",
            "deprecated",
            "withdrawn"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        },
        "replacement_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?=.{1,80}$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "changed_at",
        "replacement_id"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "mcp",
            "connector",
            "service",
            "stack",
            "cli",
            "runtime"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "setup_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "version_constraint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "authentication_required": {
          "type": "boolean"
        },
        "payment_required": {
          "type": "boolean"
        }
      },
      "required": [
        "ref",
        "name",
        "type",
        "required",
        "purpose",
        "setup_url",
        "version_constraint",
        "authentication_required",
        "payment_required"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "file_read",
            "file_write",
            "network",
            "process",
            "connector",
            "other"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "data_leaves_machine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "type",
        "scope",
        "purpose",
        "data_leaves_machine"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "supported_agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "claude",
              "codex"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event": {
                "enum": [
                  "session_start",
                  "turn_complete"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^hooks/[A-Za-z0-9_./-]+\\.py$",
                "maxLength": 240
              }
            },
            "required": [
              "event",
              "path"
            ]
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "review_notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "manifest_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "id",
            "version",
            "description",
            "author",
            "license"
          ],
          "properties": {
            "contract_version": {
              "type": "integer",
              "enum": [1, 2]
            },
            "id": {
              "type": "string",
              "pattern": "^(?=.{1,80}$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "author": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      },
      "required": [
        "version",
        "tag",
        "commit",
        "archive_sha256",
        "content_sha256",
        "approved_at",
        "status",
        "supported_agents",
        "dependencies",
        "capabilities",
        "hooks",
        "review_notes",
        "manifest_identity"
      ]
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?=.{1,80}$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "name",
            "url"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 300
        },
        "listing_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "extension_type": {
          "type": "string",
          "description": "Whether the stack extends Dryft functionality, adds domain capabilities, or both.",
          "enum": ["functionality", "capability", "both"]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "screenshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "documentation_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "support_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "first_approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "featured_rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "github_stars": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "github_stars_fetched_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "latest_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      },
      "required": [
        "id",
        "name",
        "summary",
        "description",
        "author",
        "license",
        "repository",
        "listing_url",
        "extension_type",
        "categories",
        "tags",
        "icon",
        "screenshots",
        "documentation_url",
        "support_url",
        "first_approved_at",
        "featured_rank",
        "github_stars",
        "github_stars_fetched_at",
        "status",
        "latest_version",
        "versions"
      ]
    }
  }
}
